[sub_resource type="CSharpScript" id="CSharpScript_272bh"]
script/source = "using Godot;
using System;
using System.Linq;

public partial class Rope : Node2D
{
	[Export]
	public Line2D Line { get; set; }

	[Export]
	public int SegmentsCount { get; set; } = 30;

	[Export]
	public Vector2 InitialLine { get; set; } = new(500, 0);

	[Export]
	public float LineLength { get; set; } = 1000;
	[Export]
	public int ConstraintIterations { get; set; } = 10;
	[Export]
	public float Damping { get; set; } = 0.99f;
	[Export]
	public float Friction { get; set; } = 0.3f;

	[Export]
	public Vector2 Gravity { get; set; } = new(0, 980);

	[Export]
	public bool PinStart { get; set; }

	[Export]
	public bool PinEnd { get; set; }

	private Vector2[] old_pos;
	private Vector2[] new_pos;
	private Vector2[] override_pos;
	private float segment_len;
	private int segment_count;

	public override void _Ready()
	{
		base._Ready();

		InitRope(GlobalPosition, GlobalPosition + InitialLine, SegmentsCount);
	}

	public void SetPoint(int idx, Vector2 pos)
	{
		if(idx < 0)
		{
			idx = new_pos.Length + idx;
		}
		new_pos[idx] = pos;
		old_pos[idx] = pos;
	}

	public void InitRope(Vector2 from, Vector2 to, int segmentsCount)
	{
		var distance = LineLength;
		segment_count = segmentsCount;
		segment_len = distance / segment_count;

		old_pos = new Vector2[segment_count];
		new_pos = new Vector2[segment_count];

		var over_pos = new Vector2[segment_count];
		var partVec = (from - to) / segment_count;

		for (int i = 0; i < segment_count; i++)
		{
			Vector2 pos;
			if(i == 0)
			{
				pos = from;
			}
			else if(i == segment_count - 1)
			{
				pos = to;
			}
			else
			{
				pos = new_pos[i - 1] + partVec;
			}

			new_pos[i] = pos;
			old_pos[i] = pos;
			over_pos[i] = pos;
		}

		override_pos = over_pos;
	}

	public override void _PhysicsProcess(double delta)
	{
		base._PhysicsProcess(delta);

		var spaceState = GetWorld2D().DirectSpaceState;

		for (int i = 0; i < segment_count; i++)
		{
			if(i == 0 && PinStart)
			{
				continue;
			}
			else if(i + 1 == segment_count && PinEnd)
			{
				continue;
			}

			var vel = (new_pos[i] - old_pos[i]) * Damping;
			old_pos[i] = new_pos[i];
			new_pos[i] += vel + Gravity * (float) delta * (float) delta;
		}

		for (int k = 0; k < ConstraintIterations; k++)
		{
			double totalLen = 0;

			for(int i = 0; i < segment_count - 1; i++)
			{
				totalLen += (new_pos[i] - new_pos[i + 1]).Length();
			}

			if(Math.Abs(totalLen - LineLength) / LineLength > 0.001) // 0.1%
			{
				segment_len = (float)(segment_len * ((double)LineLength) / totalLen);
			}


			for (int j = 0; j < segment_count - 1; j++)
			{
				
				var diff = new_pos[j + 1] - new_pos[j];
				float dist = diff.Length();
				if (dist == 0)
				{
					continue;
				}

				float error = (dist - segment_len) / dist * 0.5f;
				var correction = diff * error;

				if(!(j == 0 && PinStart))
				{
					new_pos[j] += correction;
				}
				if (!(j + 2 == segment_count && PinEnd))
				{
					new_pos[j + 1] -= correction;
				}
			}

			for (int i = 0; i < segment_count; i++)
			{
				if (i == 0)
				{
					continue;
				}
				if (i == segment_count - 1)
				{
					continue;
				}

				var query = PhysicsRayQueryParameters2D.Create(old_pos[i], new_pos[i], 1 << 1);
				query.CollideWithAreas = false;
				var result = spaceState.IntersectRay(query);
				if (result.Count > 0)
				{
					var hitPos = (Vector2)result[\"position\"];
					var normal = (Vector2)result[\"normal\"];

					new_pos[i] = hitPos + normal * 2.0f;

					var frictionVel = new_pos[i] - old_pos[i];
					old_pos[i] = new_pos[i] - frictionVel * Friction;
				}
			}
		}

		if(override_pos != null)
		{
			old_pos = [.. override_pos];
			new_pos = [.. override_pos];
			override_pos = null;
		}


		Line.GlobalPosition = Vector2.Zero;
		Line.Points = new_pos;
	}
}
"

